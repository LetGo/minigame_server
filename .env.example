# Copy to .env; never commit real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=18740
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_appsecret
DATABASE_URL=postgresql://minigame:REPLACE_ME@127.0.0.1:15440/minigame
REDIS_URL=redis://127.0.0.1:16390/0
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT=120
LOGIN_RATE_WINDOW_SECONDS=60
# Only enable behind the local Nginx proxy. App must remain bound to loopback.
TRUST_LOCAL_PROXY=false
