{
  "name": "minigame-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeChat minigame login API",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:client": "esbuild client/data-client.mjs --bundle --platform=browser --format=cjs --target=es2020 --minify --legal-comments=eof --outfile=client/minigame-data-client.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:dashboard": "node --test --test-concurrency=1 test/dashboard*.test.mjs",
    "pretest:integration": "npm run build",
    "test:integration": "tsx --test --test-concurrency=1 test/*.integration.ts test/*.integration.mjs",
    "start": "node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
